<mujoco model="rozum_pulse_75 scene">
<!-- Default options -->
  <compiler angle="radian" assetdir="." autolimits="true" />
  <option integrator="RK4" noslip_iterations="20" />
  
  
  <contact>
    <pair geom1="front_object_table" geom2="cube1" solref="0.02 1" solimp="0.9 0.95 0.001" />
    <pair geom1="front_object_table" geom2="cube2" solref="0.02 1" solimp="0.9 0.95 0.001" />
    <pair geom1="front_object_table" geom2="cube3" solref="0.02 1" solimp="0.9 0.95 0.001" />
  </contact>
 
  
  <default>
      <joint armature="0.1" damping="0.1" />
      <default class="visual_only">
          <!-- visual group of 'collision' of 2 is to render -->
          <!-- All geoms with contype⁠=⁠conaffinity⁠=0 are discarded -->
          <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>
      <default class="visual_collision">
          <!-- visual group of 'collision' of 2 is to render -->
          <geom type="mesh" solimp=".9 .99 .001" solref=".015 1" group="2" />
      </default>
      <default class="no_visual_collision">
          <!-- visual group of 'collision' of 3 is NOT to render -->
          <geom type="capsule" solimp=".9 .99 .001" solref=".015 1" group="3" />
      </default>
  </default>

  <include file="objects/florr_sky.xml"/>
  <include file="rozum_pulse_75.xml"/>
  
  <include file="objects/table.xml"/>
  <include file="objects/cube.xml"/>
  
  


  <statistic center="0.2 0 0.2" extent="1.0"/>

    <keyframe>
    <key name="home" 
         qpos="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0 0.4 0.71 1 0 0 0 0.1 0.4 0.75 1 0 0 0 0.45 0.4 0.81 1 0 0 0 0" 
         ctrl="-1.5708 -1.5708 1.5708 -1.5708 -1.5708 0"/>
  </keyframe>
  
</mujoco>
